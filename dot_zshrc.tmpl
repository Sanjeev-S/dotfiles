# PATH and Homebrew are set in .zshenv (needed for non-interactive SSH sessions)

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Disabled — Starship handles the prompt
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
zstyle ':omz:update' mode auto  # Silent background updates — no prompt that can eat piped input
source "$ZSH/oh-my-zsh.sh"

# Aliases
[ -f ~/.aliases ] && source ~/.aliases

# 1Password service account token (not in repo — created manually per machine)
[ -f "$HOME/.config/dotfiles/.env" ] && source "$HOME/.config/dotfiles/.env"

# Secrets (generated by chezmoi from 1Password)
[ -f "$HOME/.config/dotfiles/secrets.sh" ] && source "$HOME/.config/dotfiles/secrets.sh"

# mise
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# Zoxide
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
fi

# FZF
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# dotup failure banner
if [ -f "$HOME/.local/state/dotup/last-failure" ]; then
{{- if eq .chezmoi.os "darwin" }}
  _df=$(stat -f %m "$HOME/.local/state/dotup/last-failure")
{{- else }}
  _df=$(stat -c %Y "$HOME/.local/state/dotup/last-failure")
{{- end }}
  _age=$(( ( $(date +%s) - _df ) / 3600 ))
  _steps=$(awk -F'"failed":"' '{print $2}' "$HOME/.local/state/dotup/last-failure" | awk -F'"' '{print $1}')
  print -P "%F{red}⚠ dotup failed ${_age}h ago on $(hostname -s): ${_steps}%f"
  echo "   tail: ~/.local/state/dotup/last-run.log"
  echo "   run:  dotup --force"
  unset _df _age _steps
fi

# Starship prompt (must be last)
eval "$(starship init zsh)"
