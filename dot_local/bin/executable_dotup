#!/usr/bin/env bash
# Update dotfiles, Claude Code, Codex CLI, Cursor agent CLI, and external skills.
# Runs hourly via launchd/systemd-user; no-ops if successful run < 24h ago.
# Failure surfaces as a banner in zsh sessions; see ADR 0001.

set -uo pipefail

STATE_DIR="$HOME/.local/state/dotup"
LAST_SUCCESS="$STATE_DIR/last-success"
LAST_FAILURE="$STATE_DIR/last-failure"
RUN_LOG="$STATE_DIR/last-run.log"

mkdir -p "$STATE_DIR" || exit 1

# Lock before checking freshness or opening the shared log. Keep this file:
# the kernel releases the lock when the last inherited descriptor closes.
exec 9>>"$STATE_DIR/run.lock" || exit 1
if [ "$(uname -s)" = "Darwin" ]; then
  lock_command=(/usr/bin/lockf -s -t 0)
else
  lock_command=(flock -n -E 75)
fi
"${lock_command[@]}" 9
lock_status=$?
if [ "$lock_status" -eq 75 ]; then
  echo "dotup: skipped (another run is active)"
  exit 0
elif [ "$lock_status" -ne 0 ]; then
  echo "dotup: unable to acquire run lock (exit $lock_status)" >&2
  exit "$lock_status"
fi

force=0
if [ "${1:-}" = "--force" ]; then
  force=1
fi

if [ "$force" -eq 0 ] && [ -f "$LAST_SUCCESS" ]; then
  age=$(( $(date +%s) - $(stat -c %Y "$LAST_SUCCESS" 2>/dev/null || stat -f %m "$LAST_SUCCESS") ))
  if [ "$age" -lt 86400 ]; then
    [ -t 1 ] && echo "dotup: skipped (last success ${age}s ago, <24h); run 'dotup --force' to override"
    exit 0
  fi
fi

exec > >(tee "$RUN_LOG") 2>&1

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
[ -f "$HOME/.config/dotfiles/.env" ] && . "$HOME/.config/dotfiles/.env"

echo "==> dotup starting at $(date -u +%Y-%m-%dT%H:%M:%SZ) on $(hostname)"

failed=()

run_step() {
  local name="$1"; shift
  echo "==> [$name] $*"
  if "$@"; then
    echo "==> [$name] ok"
  else
    local rc=$?
    echo "==> [$name] FAILED (exit $rc)"
    failed+=("$name")
    return "$rc"
  fi
}

run_step chezmoi chezmoi update --force

run_step secrets "$HOME/.local/bin/secrets-refresh"

run_step skills "$HOME/.local/bin/sync-skills"

run_step claude bash -c 'set -o pipefail; curl -fsSL https://claude.ai/install.sh | bash'

run_step cursor bash -c 'set -o pipefail; curl -fsSL https://cursor.com/install | bash'

update_codex() {
  local npm_root installed_version latest_version process_status
  npm_root=$(npm root -g) || return "$?"
  installed_version=$(node -p 'require(process.argv[1]).version' \
    "$npm_root/@openai/codex/package.json" 2>/dev/null) || installed_version=""
  latest_version=$(npm view @openai/codex@latest version) || return "$?"
  if [ -z "$latest_version" ]; then
    echo "    Could not determine the latest Codex version"
    return 1
  fi
  if [ "$installed_version" = "$latest_version" ]; then
    echo "    Codex $installed_version is current"
    return 0
  fi

  # npm replaces even an unchanged package. A running Codex can then lose
  # its bundled helpers when npm removes the retired installation directory.
  # Match by install path: ChatGPT.app runs its own bundled `codex`.
  if pgrep -u "$(id -u)" -f "$npm_root/@openai/codex/" >/dev/null; then
    echo "    Codex update deferred: stop Codex sessions and the remote connection, then retry dotup --force"
    return 1
  else
    process_status=$?
    if [ "$process_status" -ne 1 ]; then
      echo "    Cannot check for running Codex processes; leaving installation intact"
      return "$process_status"
    fi
  fi
  npm install -g "@openai/codex@$latest_version"
}

if command -v npm >/dev/null 2>&1; then
  run_step codex update_codex
else
  echo "==> [codex] FAILED (npm not in PATH)"
  failed+=("codex")
fi

if [ ${#failed[@]} -eq 0 ]; then
  rm -f "$LAST_FAILURE"
  touch "$LAST_SUCCESS"
  echo "==> dotup ok"
  exit 0
fi

failed_csv=$(IFS=,; echo "${failed[*]}")
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '{"timestamp":"%s","host":"%s","failed":"%s","log":"%s"}\n' \
  "$ts" "$(hostname)" "$failed_csv" "$RUN_LOG" > "$LAST_FAILURE"

echo "==> dotup failed: $failed_csv"
exit 1
