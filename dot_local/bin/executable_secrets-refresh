#!/usr/bin/env bash
# Refresh ~/.config/dotfiles/secrets.sh from 1Password.
# Atomic: writes to .tmp and only swaps on success. On any read failure,
# the existing cache is left intact and the script exits non-zero so callers
# (e.g. dotup) can surface the failure.
set -uo pipefail

# Disable op's caching daemon. By default `op` spawns `op daemon --background`,
# which on macOS triggers a TCC prompt ("op would like to access data from other
# apps") on every run. That grant can't persist for a launchd-spawned process
# (dotup), so it re-asks ~9x daily. The daemon is pointless with service-account
# auth — op resolves secrets directly via the cloud API. Equivalent: op --cache=false.
export OP_CACHE=false

if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  echo "ERROR: OP_SERVICE_ACCOUNT_TOKEN not set." >&2
  echo "Source ~/.config/dotfiles/.env or run: chezmoi init" >&2
  exit 1
fi

if ! command -v op &>/dev/null; then
  echo "ERROR: op CLI not found in PATH." >&2
  exit 1
fi

echo "==> Refreshing secrets from 1Password..."

install -d -m 700 "$HOME/.config/dotfiles"
umask 077

SECRETS_FILE="$HOME/.config/dotfiles/secrets.sh"
TMP="$SECRETS_FILE.tmp"
: > "$TMP"
trap 'rm -f "$TMP"' EXIT

declare -a failed=()
SECRET_VAL=""

# Reads op_path, appends `export ENV_VAR=...` to $TMP on success,
# leaves the value in $SECRET_VAL for callers that need to side-effect on it.
read_secret() {
  local env_var="$1" op_path="$2"
  if SECRET_VAL="$(op read "$op_path" --no-newline 2>/dev/null)"; then
    printf 'export %s=%q\n' "$env_var" "$SECRET_VAL" >> "$TMP"
    echo "    $env_var cached"
    return 0
  fi
  echo "    WARNING: Failed to read $env_var from 1Password."
  failed+=("$env_var")
  SECRET_VAL=""
  return 1
}

read_secret NTFY_TOPIC         'op://Dotfiles/ntfy-topic/credential'
read_secret OPENROUTER_API_KEY 'op://Dotfiles/openrouter-api-key/credential'
read_secret HF_TOKEN           'op://Dotfiles/huggingface_token/credential'
read_secret COMPOSIO_MCP_KEY   'op://Dotfiles/composio_mcp_key/credential'
read_secret RUNPOD_API_KEY     'op://Dotfiles/runpod_api_key/credential'
read_secret RUNPOD_S3_ACCESS_KEY 'op://Dotfiles/runpod_s3_access_key/credential'
read_secret RUNPOD_S3_SECRET_KEY 'op://Dotfiles/runpod_s3_secret_key/credential'
read_secret THUNDERCOMPUTE_TOKEN 'op://Dotfiles/thundercompute_token/credential'
read_secret WANDB_API_KEY      'op://Dotfiles/weights_and_biases_key/credential'

if [ "${#failed[@]}" -gt 0 ]; then
  echo "==> Refresh FAILED: ${failed[*]} (existing cache left untouched)" >&2
  exit 1
fi

mv "$TMP" "$SECRETS_FILE"
trap - EXIT
echo "==> Secrets cached to ~/.config/dotfiles/secrets.sh"
