#!/usr/bin/env bash
# Daily refresh for external skill sources.
# Called from dotup; on any sub-step failure, exits 1 so the zsh banner
# names "skills" as the failed step. Missing tools (npx) are silently
# skipped — not counted as failures.
#
# npx skills: ensure desired GitHub packages are installed globally for
# Claude / Codex / Cursor, then `npx skills update -g -y` refreshes via
# the lockfile at ~/.agents/.skill-lock.json.

set -uo pipefail

# mise-managed npx lands in a non-standard PATH entry. dotup runs us from a
# systemd/launchd-minimal env, so make it findable.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

CLAUDE_SKILLS_DIR="$HOME/.claude/skills"
CODEX_SKILLS_DIR="$HOME/.codex/skills"
CURSOR_SKILLS_DIR="$HOME/.cursor/skills"
failed=()

# Agents that receive npx-installed skills (skills CLI agent ids).
NPX_SKILLS_AGENTS=(claude-code codex cursor)

run_step() {
  local name="$1"; shift
  echo "==> [$name] $*"
  if "$@"; then
    echo "==> [$name] ok"
  else
    local rc=$?
    echo "==> [$name] FAILED (exit $rc)"
    failed+=("$name")
    return "$rc"
  fi
}

npx_skill_present() {
  local name="$1"
  # Canonical store is ~/.agents/skills/; Claude gets a symlink, Cursor/Codex
  # load the universal dir directly.
  [ -e "$HOME/.agents/skills/$name" ] \
    || [ -e "$CLAUDE_SKILLS_DIR/$name" ] \
    || [ -e "$CODEX_SKILLS_DIR/$name" ] \
    || [ -e "$CURSOR_SKILLS_DIR/$name" ]
}

# Install a GitHub skill package if a sentinel skill is missing.
# Args: step-name sentinel-skill source [skills-cli --skill args...]
ensure_npx_skill_pkg() {
  local step="$1"
  local sentinel="$2"
  local source="$3"
  shift 3

  if npx_skill_present "$sentinel"; then
    echo "==> [$step] already present ($sentinel)"
    return 0
  fi

  local agent_args=()
  local agent
  for agent in "${NPX_SKILLS_AGENTS[@]}"; do
    agent_args+=(--agent "$agent")
  done

  run_step "$step" npx -y skills add "$source" \
    -g -y \
    "${agent_args[@]}" \
    "$@"
}

# --- mattpocock-skills ---
# (Stale in-skills clones from older installs are removed by the cleanups
# chezmoiscript; here we just keep the shared clone current and relink.)
# Shared clone lives OUTSIDE any agent's skills dir, so Claude Code doesn't
# discover each skill twice (once via the repo's own SKILL.md tree, once via
# our symlinks). Both agents symlink into this single clone — see link loop
# below. Self-bootstraps so sync-skills works on a fresh box without the
# install script having run first.
MP_REPO="$HOME/.local/share/mattpocock-skills"
if [ -d "$MP_REPO/.git" ]; then
  run_step matt-pull git -C "$MP_REPO" pull --ff-only --quiet
elif [ ! -e "$MP_REPO" ]; then
  run_step matt-clone git clone --single-branch --depth 1 \
    https://github.com/mattpocock/skills.git "$MP_REPO"
fi

link_matt_skills() {
  local dest_root="$1"
  local link_ok=1

  mkdir -p "$dest_root" || return 1

  for category in engineering productivity; do
    for src in "$MP_REPO/skills/$category"/*/; do
      [ -f "$src/SKILL.md" ] || continue
      name="$(basename "$src")"
      dest="$dest_root/$name"
      if [ -L "$dest" ] || [ ! -e "$dest" ]; then
        ln -sfn "$src" "$dest" || link_ok=0
      fi
    done
  done

  [ "$link_ok" -eq 1 ]
}

# Symlink loop — runs independent of the pull outcome so previously-unlinked
# skills (e.g. added upstream between dotup runs) still get linked.
if [ -d "$MP_REPO/skills" ]; then
  for target in claude codex; do
    case "$target" in
      claude) dest_root="$CLAUDE_SKILLS_DIR" ;;
      codex) dest_root="$CODEX_SKILLS_DIR" ;;
    esac

    echo "==> [matt-link-$target] re-linking engineering/ + productivity/ to $dest_root"
    if link_matt_skills "$dest_root"; then
      echo "==> [matt-link-$target] ok"
    else
      echo "==> [matt-link-$target] FAILED"
      failed+=("matt-link-$target")
    fi
  done
fi

# --- npx skills (Agent Skills ecosystem) ---
# First run installs missing packages; every run refreshes via lockfile hashes.
if command -v npx >/dev/null 2>&1; then
  # deer-flow ships many skills — pin academic-paper-review only.
  ensure_npx_skill_pkg npx-deer-flow-review academic-paper-review \
    bytedance/deer-flow --skill academic-paper-review

  # academic-research-skills: deep-research, academic-paper,
  # academic-paper-reviewer, academic-pipeline
  ensure_npx_skill_pkg npx-academic-research deep-research \
    Imbad0202/academic-research-skills --skill '*'

  run_step npx-skills-update npx -y skills update -g -y
else
  echo "==> [npx-skills] skipped (npx not in PATH)"
fi

if [ "${#failed[@]}" -gt 0 ]; then
  echo "==> sync-skills FAILED: ${failed[*]}" >&2
  exit 1
fi
echo "==> sync-skills ok"
