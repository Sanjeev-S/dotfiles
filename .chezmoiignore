# Repo-only files (not deployed to $HOME)
CLAUDE.md
README.md
AGENTS.md
CONTEXT.md
docs/**
rotate-op-token.sh
bootstrap-mac.sh
.gitignore

{{ if ne .machine_type "mac-personal" }}
# ssh client config (1Password IdentityAgent) is mac-personal only;
# .ssh/authorized_keys deploys everywhere so dev boxes trust the laptop's key
.ssh/config
{{ end }}

{{ if or (eq .machine_type "linux-dev") (eq .machine_type "dgx-spark") }}
# No LaunchAgents on Linux
Library/**
# Karabiner-Elements is macOS-only
.config/karabiner/**
{{ end }}

{{ if ne .machine_type "mac-personal" }}
# ntfy LaunchAgent is mac-personal only (dotup LaunchAgent runs on both Macs)
Library/LaunchAgents/com.sanjeev.ntfy-subscriber.plist
{{ end }}

{{ if and (ne .machine_type "linux-dev") (ne .machine_type "dgx-spark") }}
# systemd-user units only on Linux
.config/systemd/**
{{ end }}

{{ if ne .machine_type "linux-dev" }}
# Root-side wrapper that runs the Hermes CLI as the `hermes` service user is
# linux-dev only. On mac-dev, ~/.local/bin/hermes is the REAL Hermes binary
# placed by its installer — chezmoi must never manage or overwrite it there.
.local/bin/hermes
{{ end }}
