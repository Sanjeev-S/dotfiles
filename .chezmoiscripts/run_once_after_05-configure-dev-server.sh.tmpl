#!/usr/bin/env bash
set -euo pipefail

{{ if and (eq .chezmoi.os "darwin") (eq .machine_type "mac-dev") -}}
echo "==> Configuring macOS dev server..."
sudo pmset -a sleep 0
sudo pmset -a disksleep 0
sudo pmset -a disablesleep 1
sudo pmset -a autorestart 1

echo "==> Starting Eternal Terminal daemon..."
# restart, not start: recovers a bootstrapped-but-dead job, where plain
# `launchctl bootstrap` exits EIO 5. Skip when healthy so re-applies don't
# bounce live et sessions.
if ! pgrep -q etserver; then
  sudo brew services restart et
fi

echo "==> Registering Tailscale system daemon..."
if [ ! -f /Library/LaunchDaemons/com.tailscale.tailscaled.plist ]; then
  sudo "$(brew --prefix)/bin/tailscaled" install-system-daemon
fi

echo "==> Enabling Remote Login (sshd)..."
# systemsetup may need Full Disk Access for the calling terminal on recent
# macOS; if this errors, flip it in System Settings > General > Sharing.
if ! sudo systemsetup -getremotelogin | grep -q ": On"; then
  sudo systemsetup -setremotelogin on
fi

{{ else if and (eq .chezmoi.os "linux") (eq .machine_type "linux-dev") -}}
echo "==> Starting Eternal Terminal daemon..."
sudo systemctl enable --now et

{{ else if and (eq .chezmoi.os "linux") (eq .machine_type "dgx-spark") -}}
echo "==> Configuring disposable DGX Spark agent box..."

echo "$USER ALL=(ALL) NOPASSWD:ALL" | sudo tee /etc/sudoers.d/90-dgx-spark-agent >/dev/null
sudo chmod 440 /etc/sudoers.d/90-dgx-spark-agent
sudo visudo -cf /etc/sudoers.d/90-dgx-spark-agent

sudo hostnamectl set-hostname dgx-spark
sudo systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target

# Wire this box up over Ethernet. Its MT7925 Wi-Fi firmware resets roughly twice
# a day (a known MLO/6GHz defect, NVIDIA bug open as of 2026-08); the chip then
# re-associates to a WPA2 BSS and fails the 4-way handshake. NetworkManager 1.46
# reads any handshake failure as a wrong password, re-requests secrets with a flag
# that ignores the stored PSK, and — finding no secret agent on a headless box —
# sets a sticky NO_SECRETS autoconnect block that nothing short of a reboot
# clears. That stranded the Spark four times in 60 days, for up to 2.7 days each.
# A previous fix here (conf.d autoconnect-retries=0) was a no-op: invalid key,
# and retry counts do not clear a NO_SECRETS block. Ethernet removes the
# dependency entirely; Wi-Fi stays configured as a higher-metric fallback.
sudo rm -f /etc/NetworkManager/conf.d/99-headless-retry.conf

# Guard kept for non-NetworkManager images; DGX OS 7.x does ship nmcli.
if command -v nmcli >/dev/null 2>&1; then
  WIFI_CONNECTION=$(nmcli -t -f NAME,TYPE connection show --active | awk -F: '$2 == "802-11-wireless" { print $1; exit }')
  if [ -n "$WIFI_CONNECTION" ]; then
    sudo nmcli connection modify "$WIFI_CONNECTION" \
      connection.autoconnect yes \
      802-11-wireless.powersave 2
  fi
fi

echo "==> Starting Eternal Terminal daemon..."
sudo systemctl enable --now et

{{ end -}}
