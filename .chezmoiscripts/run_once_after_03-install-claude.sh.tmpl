#!/usr/bin/env bash
set -euo pipefail

echo "==> Installing Claude Code..."
curl -fsSL https://claude.ai/install.sh | bash

export PATH="$HOME/.local/bin:$PATH"

# Skills dirs for Claude; Matt Pocock + npx packages are installed/refreshed
# by sync-skills (called here and again from dotup).
mkdir -p "$HOME/.claude/skills"

# Clone/link Matt Pocock skills + ensure npx skill packages + bring
# everything to latest. Failures are reported by sync-skills' own output and
# don't abort the apply.
"$HOME/.local/bin/sync-skills" || true
