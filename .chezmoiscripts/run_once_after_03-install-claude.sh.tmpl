#!/usr/bin/env bash
set -euo pipefail

echo "==> Installing Claude Code..."
curl -fsSL https://claude.ai/install.sh | bash

export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

if command -v claude &>/dev/null; then
  echo "==> Installing Claude Code plugins..."
  claude plugin marketplace add obra/superpowers-marketplace 2>/dev/null || true
  claude plugin marketplace add EveryInc/every-marketplace 2>/dev/null || true
  claude plugin install superpowers@superpowers-marketplace
  claude plugin install compound-engineering@compound-engineering-plugin
else
  echo "    Skipping Claude plugins (claude not found in PATH)"
fi

# ── Non-marketplace skills (cloned directly into ~/.claude/skills) ──
SKILLS_DIR="$HOME/.claude/skills"
mkdir -p "$SKILLS_DIR"

# gstack — Garry Tan's engineering team in slash commands
GSTACK_DIR="$SKILLS_DIR/gstack"
if [ ! -d "$GSTACK_DIR/.git" ]; then
  echo "==> Cloning gstack..."
  git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git "$GSTACK_DIR"
else
  echo "==> Updating gstack..."
  git -C "$GSTACK_DIR" pull --ff-only --quiet || true
fi
if command -v bun &>/dev/null; then
  (cd "$GSTACK_DIR" && ./setup -q --no-team)
else
  echo "    Skipping gstack ./setup (bun not found — re-run after mise installs bun)"
fi

# mattpocock/skills — curated skills from his plugin.json (no marketplace published)
MP_REPO="$SKILLS_DIR/mattpocock-skills"
if [ ! -d "$MP_REPO/.git" ]; then
  echo "==> Cloning mattpocock/skills..."
  git clone --single-branch --depth 1 https://github.com/mattpocock/skills.git "$MP_REPO"
else
  echo "==> Updating mattpocock/skills..."
  git -C "$MP_REPO" pull --ff-only --quiet || true
fi

echo "==> Linking mattpocock skills..."
# Opt-in everything under engineering/ and productivity/ that ships a SKILL.md.
# Add a deny-list here if a specific skill turns out to be unwanted.
for category in engineering productivity; do
  for src in "$MP_REPO/skills/$category"/*/; do
    [ -f "$src/SKILL.md" ] || continue
    name="$(basename "$src")"
    dest="$SKILLS_DIR/$name"
    if [ -L "$dest" ] || [ ! -e "$dest" ]; then
      ln -sfn "$src" "$dest"
    else
      echo "    Skipping $name (target exists and is not a symlink)"
    fi
  done
done
