#!/usr/bin/env bash
set -euo pipefail

{{ if or (eq .machine_type "mac-personal") (eq .machine_type "mac-dev") -}}
# Re-runs whenever the plist template changes; reload-style (bootout +
# bootstrap) so edits actually take effect on existing machines.
# plist hash: {{ include "private_Library/LaunchAgents/com.sanjeev.dotup.plist.tmpl" | sha256sum }}
echo "==> Loading dotup LaunchAgent..."
PLIST="$HOME/Library/LaunchAgents/com.sanjeev.dotup.plist"

launchctl bootout gui/"$(id -u)" "$PLIST" 2>/dev/null || true
launchctl bootstrap gui/"$(id -u)" "$PLIST"
echo "    dotup LaunchAgent loaded (hourly)"

{{ else if eq .machine_type "linux-dev" -}}
# unit hashes: {{ include "dot_config/systemd/user/dotup.service" | sha256sum }} {{ include "dot_config/systemd/user/dotup.timer" | sha256sum }}
echo "==> Enabling dotup systemd-user timer..."
systemctl --user daemon-reload
systemctl --user enable --now dotup.timer
echo "    dotup.timer enabled"

LINGER=$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null || echo "no")
if [ "$LINGER" != "yes" ]; then
  cat <<EOF

==> ACTION REQUIRED
    systemd-user linger is not enabled for $USER.
    Without linger, dotup.timer stops when your last login session ends.
    To enable unattended operation, run once:

        sudo loginctl enable-linger $USER

EOF
fi

{{ end -}}
