#!/usr/bin/env bash
set -euo pipefail

{{ if eq .machine_type "mac-personal" -}}
# Seed the laptop's native machine catalog; Herdr owns IDs, enabled state, and
# later additions. Bare `herdr` connects Local plus every enabled saved machine.
# Provision the dev boxes first. Failed SSH/setup is retried on the next apply;
# never approve a remote server replacement from this unattended hook.
while read -r target session; do
  machines="$(herdr machine list --json)"
  if ! jq -e --arg target "$target" 'any(.target == $target)' \
    <<< "$machines" >/dev/null; then
    herdr machine add "$target" --label "$target" --remote-session "$session"
  fi
done <<'MACHINES'
macmini default
dgx-spark default
hetzner-16g main
MACHINES
{{ end -}}
