[Unit]
Description=Cursor My Machines worker (agent worker start)
After=network-online.target
Wants=network-online.target
# Never give up restarting; the worker is the only way in from Cursor.
StartLimitIntervalSec=0

[Service]
# --verbose logs a "Received frame" heartbeat every ~30s, so a worker that is
# alive but disconnected from Cursor shows up as a gap in journalctl.
ExecStart=%h/.local/bin/agent worker start --name dgx-spark --verbose
WorkingDirectory=%h
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
