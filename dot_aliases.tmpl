# Aliases
alias hetzner-16g-tunnel="ssh -N hetzner-16g-tunnel"
function hetzner-16g-connect() {
    ssh -N hetzner-16g-tunnel &
    local tunnel_pid=$!
    et root@hetzner-16g -c 'tmux -CC new-session -A -s main'
    kill $tunnel_pid 2>/dev/null
}
alias macmini-connect="et sanjeevsuresh@macmini -c 'tmux -CC new-session -A -s main'"
alias dgx-spark-connect="et sanjeevsuresh@dgx-spark -c 'tmux -CC new-session -A -s main'"

# herdr trial (2026-07, see docs/plans/2026-07-12-002-eval-herdr-trial-plan.md)
function hetzner-16g-herdr() {
    ssh -N hetzner-16g-tunnel &
    local tunnel_pid=$!
    et root@hetzner-16g -c 'herdr'
    kill $tunnel_pid 2>/dev/null
}
alias hetzner-16g-herdr-native="herdr --remote hetzner-16g"

# Spark herdr needs no tunnel: tailnet boxes get flat network access.
alias dgx-spark-herdr="et sanjeevsuresh@dgx-spark -c 'herdr'"
alias dgx-spark-herdr-native="herdr --remote dgx-spark"
alias cc="claude"
alias cx="codex"

# Personal Hermes gateway on Hetzner runs as the `hermes` service user; root's
# wrapper (dot_local/bin/executable_hermes, linux-dev only) does the uid hop,
# so `hermes-hetzner gateway status|restart|stop` etc. work from anywhere. ADR 0006.
alias hermes-hetzner="ssh hetzner-16g hermes"
alias hermes-hetzner-logs="ssh hetzner-16g -- runuser -u hermes -- tail -n 50 /home/hermes/.hermes/logs/gateway.log"

# Antigravity CLI: auto-approve tool actions on trusted dev/personal boxes.
# agy has no settings file — --dangerously-skip-permissions is the only lever (see ADR 0003).
{{ if or (eq .machine_type "linux-dev") (eq .machine_type "mac-dev") (eq .machine_type "mac-personal") (eq .machine_type "dgx-spark") -}}
alias agy="agy --dangerously-skip-permissions"
{{ end -}}
