# Aliases
alias hetzner-16g-tunnel="ssh -N hetzner-16g-tunnel"
function hetzner-16g-connect() {
    ssh -N hetzner-16g-tunnel &
    local tunnel_pid=$!
    et root@hetzner-16g -c 'tmux -CC new-session -A -s main'
    kill $tunnel_pid 2>/dev/null
}
alias macmini-connect="et sanjeevsuresh@sanjeevs-mac-mini -c 'tmux -CC new-session -A -s main'"

# herdr trial (2026-07, see docs/plans/2026-07-12-002-eval-herdr-trial-plan.md)
function hetzner-16g-herdr() {
    ssh -N hetzner-16g-tunnel &
    local tunnel_pid=$!
    et root@hetzner-16g -c 'herdr'
    kill $tunnel_pid 2>/dev/null
}
alias hetzner-16g-herdr-native="herdr --remote hetzner-16g"
alias cc="claude"
alias cx="codex"

# Antigravity CLI: auto-approve tool actions on trusted dev/personal boxes.
# agy has no settings file — --dangerously-skip-permissions is the only lever (see ADR 0003).
{{ if or (eq .machine_type "linux-dev") (eq .machine_type "mac-dev") (eq .machine_type "mac-personal") (eq .machine_type "dgx-spark") -}}
alias agy="agy --dangerously-skip-permissions"
{{ end -}}
